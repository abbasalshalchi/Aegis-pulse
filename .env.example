# Copy to .env and fill in. Never commit .env (already in .gitignore).
# These map to nuxt.config.ts runtimeConfig keys and are server-only —
# they are never exposed to the browser.

# MongoDB Atlas data layer (server/api/towers.get.js)
NUXT_MONGO_DATA_URL=
NUXT_MONGO_DATA_KEY=
NUXT_MONGO_DATA_SOURCE=AegisCluster

# Gemini API (server/api/analysis.post.js) — get a key from Google AI Studio
NUXT_GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash in the route if left blank
NUXT_GEMINI_MODEL=gemini-3.5-flash

# Weather (WeatherAPI.com forecast.json) — used by the analysis route
NUXT_WEATHER_API_URL=https://api.weatherapi.com/v1/forecast.json
NUXT_WEATHER_API_KEY=
